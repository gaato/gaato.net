{
	"name": "gaato-net",
	"private": true,
	"version": "0.2.0",
	"license": "BlueOak-1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"audit": "bun audit --audit-level=high",
		"check:artifacts": "bun scripts/check-artifacts.ts",
		"check:licenses": "bun scripts/check-third-party-notices.ts",
		"test:e2e": "playwright test",
		"prepare:preview-headers": "bun scripts/prepare-preview-headers.ts",
		"verify": "bun run check && bun run test && bun run build && bun run check:licenses && bun run check:artifacts && bun run test:e2e",
		"writing:update": "bun scripts/update-writing.ts",
		"wrangler": "wrangler"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.13.6",
		"fast-xml-parser": "^5.11.1",
		"marked": "^18.0.13",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"wrangler": "^4.135.0",
		"yaml": "^2.9.1"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"nanoid": "^3.3.19",
		"postcss": "^8.5.28"
	},
	"trustedDependencies": [
		"esbuild",
		"workerd"
	],
	"dependencies": {
		"katex": "^0.18.7",
		"marked-katex-extension": "^5.1.13"
	}
}
