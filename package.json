{
  "name": "gaato-net",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "moon build --target wasm-gc --release src/background",
    "check:moon": "moon check --target wasm-gc src/background",
    "check:rules": "moon check --target native src/rule_scan",
    "score:rules": "moon run --target native --release src/rule_scan",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "wrangler": "wrangler",
    "typecheck": "tsc --noEmit",
    "dev": "bun run build && vite preview --host 127.0.0.1",
    "preview": "vite preview",
    "build": "bun run build:wasm && node scripts/build-site.mjs",
    "validate:html": "node scripts/validate-html.mjs",
    "check:a11y": "pa11y-ci http://127.0.0.1:4173/ http://127.0.0.1:4173/posts/ http://127.0.0.1:4173/tags/ http://127.0.0.1:4173/posts/rc-s380-blank-tag/",
    "check:smoke": "node scripts/smoke-site.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "bun run check:toolchain && bun run typecheck && bun run check:moon && bun run check:rules && bun run build && bun run validate:html && bun run check:size"
  },
  "devDependencies": {
    "@luna_ui/astra": "^0.22.0",
    "cheerio": "^1.1.2",
    "pa11y-ci": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vnu-jar": "^26.4.16",
    "wrangler": "^4.103.0",
    "yaml": "^2.9.0"
  },
  "trustedDependencies": [
    "esbuild",
    "puppeteer",
    "sharp",
    "workerd",
    "vnu-jar"
  ]
}
