{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gaato-net",
  "compatibility_date": "2026-05-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "workers_dev": true
    }
  }
}
